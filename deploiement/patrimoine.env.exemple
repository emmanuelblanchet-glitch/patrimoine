# Modèle de /home/ubuntu/patrimoine/patrimoine.env (droits 600). Aucune valeur réelle ici.
# PATRIMOINE_MODE=public est posé par compose.yml, pas ici.
# L'hôte attendu dans l'en-tête Host, exactement : nom tailnet du VPS et port.
PATRIMOINE_HOTE_PUBLIC=COLLE-ICI-machine.mon-tailnet.ts.net:8006
# Ton login Tailscale (l'en-tête Tailscale-User-Login que le relais ajoute).
PATRIMOINE_UTILISATEUR=COLLE-ICI-ton-login-tailscale
# Ces deux lignes-là, c'est node scripts/empreinte-phrase.mjs qui les écrit.
PATRIMOINE_PHRASE_EMPREINTE=COLLE-ICI
PATRIMOINE_SECRET_SESSION=COLLE-ICI
# Claude rédige (facultatif).
ANTHROPIC_API_KEY=COLLE-ICI
ANTHROPIC_WORKSPACE_ID=COLLE-ICI
