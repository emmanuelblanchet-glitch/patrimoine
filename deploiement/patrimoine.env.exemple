# Modèle de /home/ubuntu/patrimoine/patrimoine.env (droits 600). Aucune valeur réelle ici.
# Mode public : l'hôte attendu dans l'en-tête Host, exactement.
PATRIMOINE_HOTE_PUBLIC=vps-memoire.tailde497c.ts.net:8006
# Ton identifiant Tailscale (l'en-tête Tailscale-User-Login que le relais ajoute).
PATRIMOINE_UTILISATEUR=COLLE-ICI-ton-login-tailscale
# Sortie de : printf '%s' 'ta phrase' | node scripts/empreinte-phrase.mjs
PATRIMOINE_PHRASE_EMPREINTE=COLLE-ICI-scrypt$...
PATRIMOINE_SECRET_SESSION=COLLE-ICI-64-caracteres-hexadecimaux
# Claude rédige (facultatif).
ANTHROPIC_API_KEY=COLLE-ICI
ANTHROPIC_WORKSPACE_ID=COLLE-ICI
# Phrase des sauvegardes chiffrées : la même dans ton gestionnaire de mots de passe.
PATRIMOINE_SAUVEGARDE_PHRASE=COLLE-ICI-une-phrase-longue
